<Window x:Class="SurveyAnalyzer.WPF.Windows.ChartsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Графики — визуализация данных"
        Height="720" Width="1000"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ ЗАГОЛОВОК ============ -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="📊 Графики — визуализация данных" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="Три способа визуализации распределения: гистограмма, ящик с усами и диаграмма рассеяния. Переключайтесь между вкладками."
                       Style="{StaticResource SubHeaderText}"/>
        </StackPanel>

        <!-- ============ ВКЛАДКИ ============ -->
        <TabControl Grid.Row="1" x:Name="TabCharts">

            <TabItem Header="📊 Гистограмма">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Распределение частот: сколько раз встречается каждое значение."
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,8,0,8"/>
                    <Border Background="White" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="6">
                        <Canvas x:Name="CanvasHistogram" Background="White"/>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="📦 Ящик с усами">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Box Plot: Q1, медиана, Q3, усы (1.5·IQR) и выбросы."
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,8,0,8"/>
                    <Border Background="White" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="6">
                        <Canvas x:Name="CanvasBoxPlot" Background="White"/>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="🔵 Диаграмма рассеяния">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Значения по индексам: видно выбросы и общую тенденцию."
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,8,0,8"/>
                    <Border Background="White" BorderBrush="#E1E4E8" BorderThickness="1" CornerRadius="6">
                        <Canvas x:Name="CanvasScatter" Background="White"/>
                    </Border>
                </DockPanel>
            </TabItem>

        </TabControl>

        <!-- ============ КНОПКИ ============ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="🔄 Обновить графики"
                    Click="BtnRefresh_Click"
                    Margin="0,0,10,0"
                    ToolTip="Перерисовать графики (если меняли данные)."/>
            <Button Content="💾 Сохранить изображения"
                    Click="BtnSave_Click"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,10,0"
                    ToolTip="Сохранить гистограмму и box plot как PNG-файлы."/>
            <Button Content="Закрыть"
                    Click="BtnClose_Click"
                    Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
    </Grid>
</Window>