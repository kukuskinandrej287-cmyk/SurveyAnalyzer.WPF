<Window x:Class="SurveyAnalyzer.WPF.Windows.DataPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр данных"
        Height="650" Width="850"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ ЗАГОЛОВОК ============ -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="📋 Просмотр данных" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="Первые 200 значений массива и распределение частот по каждому значению."
                       Style="{StaticResource SubHeaderText}"/>
        </StackPanel>

        <!-- ============ ДВЕ КОЛОНКИ ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: массив -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Исходный массив (первые 200 значений)"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="TxtRaw"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             AcceptsReturn="True"
                             FontFamily="Consolas" FontSize="12"
                             TextWrapping="Wrap"
                             Padding="8"
                             ToolTip="Первые 200 значений сгенерированного массива."/>
                </DockPanel>
            </Border>

            <!-- Правая колонка: частоты -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Распределение частот"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               Margin="0,0,0,8"/>
                    <DataGrid x:Name="GridFreq"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#F7F9FB"
                              BorderBrush="#E1E4E8"
                              BorderThickness="1"
                              ToolTip="Таблица: значение → сколько раз оно встречается.">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Значение"
                                                Binding="{Binding Value}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Частота"
                                                Binding="{Binding Count}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Доля, %"
                                                Binding="{Binding Percent}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ КНОПКИ ============ -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="📋 Скопировать всё"
                    Click="BtnCopy_Click"
                    Margin="0,0,10,0"
                    ToolTip="Скопировать массив и таблицу частот в буфер обмена."/>
            <Button Content="💾 Сохранить в файл"
                    Click="BtnSave_Click"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,10,0"
                    ToolTip="Сохранить данные в текстовый файл (.txt)."/>
            <Button Content="Закрыть"
                    Click="BtnClose_Click"
                    Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
    </Grid>
</Window>