<Window x:Class="SurveyAnalyzer.WPF.Windows.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Статистические характеристики"
        Height="650" Width="700"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="📈 Статистические характеристики" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="Полный набор мер центральной тенденции и разброса. Наведите курсор на метрику — появится пояснение."
                       Style="{StaticResource SubHeaderText}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="MetricsPanel"/>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="📋 Скопировать всё"
                    Click="BtnCopy_Click"
                    Margin="0,0,10,0"
                    ToolTip="Скопировать все метрики в буфер обмена."/>
            <Button Content="💾 Сохранить в файл"
                    Click="BtnSave_Click"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,10,0"
                    ToolTip="Сохранить метрики в текстовый файл."/>
            <Button Content="Закрыть"
                    Click="BtnClose_Click"
                    Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
    </Grid>
</Window>