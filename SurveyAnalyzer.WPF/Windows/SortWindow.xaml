<Window x:Class="SurveyAnalyzer.WPF.Windows.SortWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сортировка данных"
        Height="650" Width="850"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ ЗАГОЛОВОК ============ -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="🔀 Сортировка данных" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="Сравните работу QuickSort и MergeSort на ваших данных. Время замеряется автоматически с помощью Stopwatch."
                       Style="{StaticResource SubHeaderText}"/>
        </StackPanel>

        <!-- ============ ПАНЕЛЬ УПРАВЛЕНИЯ ============ -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Алгоритм:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           FontWeight="SemiBold"/>
                <ComboBox x:Name="CmbAlgo"
                          Width="220"
                          SelectedIndex="2"
                          VerticalContentAlignment="Center"
                          ToolTip="Выберите алгоритм сортировки: QuickSort, MergeSort или сравнение обоих.">
                    <ComboBoxItem Content="QuickSort"/>
                    <ComboBoxItem Content="MergeSort"/>
                    <ComboBoxItem Content="Оба (сравнение)"/>
                </ComboBox>
                <Button Content="▶ Запустить сортировку"
                        Click="BtnRun_Click"
                        Margin="20,0,0,0"
                        ToolTip="Отсортирует массив выбранным алгоритмом и замерит время выполнения."/>
            </StackPanel>
        </Border>

        <!-- ============ РЕЗУЛЬТАТ ============ -->
        <TextBox Grid.Row="2"
                 x:Name="TxtResult"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 AcceptsReturn="True"
                 FontFamily="Consolas" FontSize="12"
                 Padding="10"
                 TextWrapping="NoWrap"
                 ToolTip="Результат сортировки. Можно выделить и скопировать (Ctrl+C) или сохранить в файл."/>

        <!-- ============ КНОПКИ ============ -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="📋 Скопировать"
                    Click="BtnCopy_Click"
                    Margin="0,0,10,0"
                    ToolTip="Скопировать результат в буфер обмена."/>
            <Button Content="💾 Сохранить в файл"
                    Click="BtnSave_Click"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,10,0"
                    ToolTip="Сохранить результат в текстовый файл (.txt)."/>
            <Button Content="Закрыть"
                    Click="BtnClose_Click"
                    Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
    </Grid>
</Window>