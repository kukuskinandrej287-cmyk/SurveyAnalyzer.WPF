<Window x:Class="SurveyAnalyzer.WPF.Windows.OutliersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поиск аномалий (IQR)"
        Height="620" Width="750"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ ЗАГОЛОВОК ============ -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="⚠️ Поиск аномалий" Style="{StaticResource HeaderText}"/>
            <TextBlock Text="Метод межквартильного размаха (IQR). Аномалии — значения за границами Q1 − 1.5·IQR и Q3 + 1.5·IQR."
                       Style="{StaticResource SubHeaderText}"/>
        </StackPanel>

        <!-- ============ СВОДКА И КНОПКА ============ -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="TxtSummary"
                           Text="Нажмите кнопку ниже, чтобы найти аномалии в текущем массиве данных."
                           FontSize="14"
                           TextWrapping="Wrap"/>
                <Button Content="🔍 Найти аномалии"
                        Click="BtnFind_Click"
                        HorizontalAlignment="Left"
                        Margin="0,12,0,0"
                        ToolTip="Запустит поиск выбросов методом IQR на текущем массиве данных."/>
            </StackPanel>
        </Border>

        <!-- ============ РЕЗУЛЬТАТ ============ -->
        <TextBox Grid.Row="2"
                 x:Name="TxtOutliers"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12"
                 Padding="10"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 ToolTip="Список найденных аномалий. Можно скопировать или сохранить в файл."/>

        <!-- ============ КНОПКИ ============ -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="📋 Скопировать"
                    Click="BtnCopy_Click"
                    Margin="0,0,10,0"
                    ToolTip="Скопировать список аномалий в буфер обмена."/>
            <Button Content="💾 Сохранить в файл"
                    Click="BtnSave_Click"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,10,0"
                    ToolTip="Сохранить список аномалий в текстовый файл (.txt)."/>
            <Button Content="Закрыть"
                    Click="BtnClose_Click"
                    Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
    </Grid>
</Window>