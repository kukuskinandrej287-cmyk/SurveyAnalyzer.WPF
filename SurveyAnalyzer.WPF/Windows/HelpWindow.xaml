<Window x:Class="SurveyAnalyzer.WPF.Windows.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справка — как пользоваться программой"
        Height="650" Width="800"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="❓ Справка — как пользоваться программой"
                       Style="{StaticResource HeaderText}"/>
            <TextBlock Text="Пошаговое руководство для пользователя. Если что-то непонятно — начните отсюда."
                       Style="{StaticResource SubHeaderText}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="📌 Шаг 1. Генерация данных"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                            На главном экране задайте количество респондентов (от 10 до 100 000)
                            с помощью ползунка или введите число вручную. Затем укажите диапазон оценок
                            (по умолчанию от 1 до 10) и нажмите кнопку «🎲 Сгенерировать данные».
                            Программа создаст случайный массив оценок для анализа.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="📈 Шаг 2. Статистические характеристики"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                            Нажмите «Открыть окно статистики». Откроется отдельное окно с полным набором
                            метрик: среднее, медиана, мода, дисперсия, стандартное отклонение,
                            минимум и максимум. Наведите мышь на любую метрику — появится подсказка
                            с пояснением. Результат можно скопировать (Ctrl+C) или сохранить в файл.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="🔀 Шаг 3. Сортировка данных"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                            Нажмите «Открыть окно сортировки». Выберите алгоритм (QuickSort,
                            MergeSort или сравнение обоих) и нажмите «▶ Запустить сортировку».
                            Программа отсортирует массив и замерит время работы каждого алгоритма.
                            Результат можно скопировать или сохранить.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="⚠️ Шаг 4. Поиск аномалий"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                            Нажмите «Открыть окно аномалий» → «🔍 Найти аномалии». Программа
                            найдёт выбросы методом межквартильного размаха (IQR). Аномалии —
                            это значения, которые сильно отличаются от остальных. Список можно
                            скопировать или сохранить.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="📋 Шаг 5. Просмотр данных"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                            Нажмите «Открыть окно данных», чтобы увидеть первые 200 значений массива
                            и таблицу распределения частот по каждому значению. Полезно для
                            контроля корректности ввода и понимания структуры данных.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="💡 Полезные советы"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                            • В любой момент наведите мышь на любую кнопку — появится подсказка,
                            что она делает.{LineBreak}
                            • Все результаты можно скопировать в буфер обмена (Ctrl+C) или
                            сохранить в файл.{LineBreak}
                            • Данные хранятся до следующей генерации. Если закрыть окно
                            статистики, данные не потеряются — можно снова открыть любое окно.
                        </TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Закрыть"
                    Click="BtnClose_Click"
                    Style="{StaticResource SecondaryButton}"/>
        </StackPanel>
    </Grid>
</Window>